# =============================================================================
# Replit Secrets Yapılandırması
# =============================================================================
# Bu dosya Replit'te Secrets olarak eklenmesi gereken değerleri gösterir.
#
# KULLANIM:
# 1. Replit'te Tools > Secrets menüsünü açın
# 2. Aşağıdaki her bir değer için yeni secret ekleyin
# 3. Key'leri AYNEN kullanın (OPENAI_API_KEY gibi)
# 4. Value'lara kendi API anahtarlarınızı girin
# =============================================================================

# ----- ZORUNLU -----

# OpenAI API Key (GPT-4 ve DALL-E için)
# Nereden alınır: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# ----- OPSİYONEL -----

# Anthropic Claude API (ChatBot için alternatif AI)
# Nereden alınır: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Pinterest API (Gerçek Pinterest verisi için)
# Nereden alınır: https://developers.pinterest.com/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=

# Fal.ai API (Görsel üretimi için - DALL-E alternatifi)
# Nereden alınır: https://fal.ai/
FAL_KEY=

# ----- DİĞER AYARLAR -----
# Bunları genelde değiştirmeye gerek yok, Replit otomatik ayarlar

# Port (Replit otomatik atar)
# PORT=8080

# Debug mode (Production'da False yapın)
DEBUG=True

# CORS (Replit için genelde * yeterli)
ALLOWED_ORIGINS=*

# =============================================================================
# NASIL EKLENİR?
# =============================================================================
#
# Replit'te:
# 1. Sol menüden Tools > Secrets tıklayın
# 2. "New Secret" butonuna tıklayın
# 3. Key: OPENAI_API_KEY
# 4. Value: sk-proj-abc123... (kendi API keyiniz)
# 5. "Add Secret" tıklayın
# 6. Diğer secrets için tekrarlayın
#
# NOT: Secrets otomatik olarak environment variable'lara dönüşür!
# =============================================================================

# =============================================================================
# GÜVENLİK UYARISI
# =============================================================================
# ⚠️  API anahtarlarınızı asla:
# - GitHub'a commit etmeyin
# - Public olarak paylaşmayın
# - Kod içine yazmayın
#
# ✅ Sadece Replit Secrets kullanın!
# =============================================================================
